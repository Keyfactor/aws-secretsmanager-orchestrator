<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <runtime>
    <assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">
      <dependentAssembly>
        <assemblyIdentity name="Microsoft.Extensions.Logging.Abstractions"
                          publicKeyToken="adb9793829ddae60"
                          culture="neutral" />
        <!-- Redirect the net472 build's reference to 8.0.0.0 up to the resolved 8.0.1.0 -->
        <bindingRedirect oldVersion="0.0.0.0-8.0.1.0" newVersion="8.0.1.0" />
      </dependentAssembly>
    </assemblyBinding>
  </runtime>
</configuration>
